pkgname=pqvpn
pkgver=0.0.2.alpha.20261008.packages
pkgrel=1
pkgdesc='Post-quantum peer-to-peer VPN node and consoles'
arch=('x86_64' 'aarch64')
url='https://tadaka9.github.io/PQVPN/'
license=('MIT')
depends=('argon2' 'liboqs' 'openssl' 'qt6-base')
makedepends=('cmake' 'git' 'ninja')
_commit='eb80e7aeb5c51e7ff26eaf3c8c4c969e5bc27cf2'
source=("$pkgname-$pkgver.tar.gz::https://github.com/tadaka9/PQVPN/archive/$_commit.tar.gz")
sha256sums=('c055603f62645c9b839de15e2cc092fdc09a7a7c52eb13e4226ccaa8bd974586')

build() {
  cmake -S "PQVPN-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DPQVPN_BUILD_MONITOR=ON
  cmake --build build --parallel
}

check() {
  build/pqvpn_node --smoke-test \
    --config "PQVPN-$_commit/config.json"
  QT_QPA_PLATFORM=offscreen build/pqvpn_monitor --smoke-test
}

package() {
  install -Dm755 build/pqvpn_node "$pkgdir/usr/bin/pqvpn_node"
  install -Dm755 build/pqvpn_tui "$pkgdir/usr/bin/pqvpn_tui"
  install -Dm755 build/pqvpn_monitor "$pkgdir/usr/bin/pqvpn_monitor"
  install -Dm644 "PQVPN-$_commit/config.json" \
    "$pkgdir/usr/share/pqvpn/examples/config.json"
  install -Dm644 "PQVPN-$_commit/config.udp2raw.json" \
    "$pkgdir/usr/share/pqvpn/examples/config.udp2raw.json"
  install -Dm644 "PQVPN-$_commit/README.md" \
    "$pkgdir/usr/share/doc/pqvpn/README.md"
  install -Dm644 "PQVPN-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/pqvpn/LICENSE"
}
