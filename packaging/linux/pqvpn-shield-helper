#!/bin/bash
set -euo pipefail

# Narrow privileged boundary for the Privacy Console.  The desktop process
# chooses a named preset; it cannot supply arbitrary list URLs, database paths
# or commands.  Optional deny expressions remain individual argv values and
# are passed directly to Pi-hole without shell evaluation.

[[ $EUID -eq 0 ]] || { echo "PQVPN Shield requires administrator authorization" >&2; exit 1; }
[[ "${1:-}" == apply && $# -ge 2 ]] || {
  echo "usage: pqvpn-shield-helper apply privacy|security|family|maximum [REGEX ...]" >&2
  exit 2
}

profile="$2"
shift 2
(( $# <= 128 )) || { echo "too many custom regex rules (maximum 128)" >&2; exit 2; }

oisd="https://big.oisd.nl/"
hagezi_pro="https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/domains/pro.txt"
hagezi_tif="https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/domains/tif.txt"
hagezi_nsfw="https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/domains/nsfw.txt"
hagezi_gambling="https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/domains/gambling.txt"

case "$profile" in
  privacy)  sources=("$oisd") ;;
  security) sources=("$oisd" "$hagezi_tif") ;;
  family)   sources=("$oisd" "$hagezi_tif" "$hagezi_nsfw" "$hagezi_gambling") ;;
  maximum)  sources=("$oisd" "$hagezi_pro" "$hagezi_tif" "$hagezi_nsfw" "$hagezi_gambling") ;;
  *) echo "unknown shield profile: $profile" >&2; exit 2 ;;
esac

pihole=""
ftl=""
for candidate in /usr/local/bin/pihole /usr/bin/pihole; do [[ -x "$candidate" ]] && { pihole="$candidate"; break; }; done
for candidate in /usr/bin/pihole-FTL /usr/local/bin/pihole-FTL; do [[ -x "$candidate" ]] && { ftl="$candidate"; break; }; done
[[ -n "$pihole" && -n "$ftl" ]] || { echo "Pi-hole CLI and FTL are required" >&2; exit 3; }
[[ -f /etc/pihole/gravity.db ]] || { echo "Pi-hole gravity database was not found" >&2; exit 3; }

sql="BEGIN IMMEDIATE;"
for source in "${sources[@]}"; do
  sql+="INSERT OR IGNORE INTO adlist (address,enabled,comment) VALUES ('$source',1,'PQVPN Shield');"
done
sql+="COMMIT;"
"$ftl" sqlite3 -ni /etc/pihole/gravity.db "$sql"

for expression in "$@"; do
  [[ -n "$expression" && ${#expression} -le 512 ]] || { echo "invalid custom regex length" >&2; exit 2; }
  [[ "$expression" != *$'\n'* && "$expression" != *$'\r'* ]] || {
    echo "custom regex contains a forbidden control character" >&2; exit 2;
  }
  "$pihole" --regex "$expression"
done

"$pihole" -g
echo "PQVPN Shield profile '$profile' applied"
