#!/bin/bash
set -euo pipefail

action="${1:-}"
tun="${2:-}"
exit_ip="${3:-}"
exit_port="${4:-}"
internal_ip="${5:-}"
shield_profile="${6:-off}"
control_endpoints="${7:-$exit_ip:$exit_port}"
state=/run/pqvpn/network.env

[[ $EUID -eq 0 ]] || { echo "PQVPN network setup requires root" >&2; exit 1; }
[[ "$tun" =~ ^[a-zA-Z0-9_.-]{1,15}$ ]] || { echo "invalid TUN interface" >&2; exit 2; }
[[ "$exit_ip" =~ ^[0-9.]+$ && "$exit_port" =~ ^[0-9]{1,5}$ ]] || { echo "invalid exit endpoint" >&2; exit 2; }
if [[ "$action" == up ]]; then
  [[ "$internal_ip" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || {
    echo "invalid authenticated tunnel address" >&2; exit 2;
  }
fi
case "$shield_profile" in off|dnscrypt|privacy|security|family|maximum) ;; *) echo "invalid DNS Shield profile" >&2; exit 2;; esac

control_ips_csv=""
if [[ "$action" == up ]]; then
  IFS=',' read -ra endpoints <<<"$control_endpoints"
  [[ ${#endpoints[@]} -gt 0 && ${#endpoints[@]} -le 32 ]] || { echo "invalid control endpoint list" >&2; exit 2; }
  for endpoint in "${endpoints[@]}"; do
    host="${endpoint%:*}"
    port="${endpoint##*:}"
    [[ "$host" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$port" =~ ^[0-9]{1,5}$ && "$port" -ge 1 && "$port" -le 65535 ]] || {
      echo "invalid control endpoint" >&2; exit 2
    }
    IFS='.' read -ra octets <<<"$host"
    for octet in "${octets[@]}"; do ((10#$octet <= 255)) || { echo "invalid control endpoint" >&2; exit 2; }; done
    case ",$control_ips_csv," in *",$host,"*) ;; *) control_ips_csv="${control_ips_csv:+$control_ips_csv,}$host" ;; esac
  done
fi

down() {
  nft delete table inet pqvpn 2>/dev/null || true
  resolvectl revert "$tun" 2>/dev/null || true
  ip -4 route del default dev "$tun" metric 5 2>/dev/null || true
  ip -6 route del unreachable default metric 5 2>/dev/null || true
  if [[ -r "$state" ]]; then
    # shellcheck disable=SC1090
    source "$state"
    if [[ -n "${physical_dev:-}" ]]; then
      IFS=',' read -ra cleanup_ips <<<"${control_ips_csv:-$exit_ip}"
      for control_ip in "${cleanup_ips[@]}"; do
        ip -4 route del "$control_ip/32" dev "$physical_dev" 2>/dev/null || true
      done
    fi
  fi
  ip addr flush dev "$tun" scope global 2>/dev/null || true
  ip link set "$tun" down 2>/dev/null || true
  ip tuntap del dev "$tun" mode tun 2>/dev/null || true
  rm -f "$state"
}

if [[ "$action" == down ]]; then down; exit 0; fi
if [[ "$action" == prepare ]]; then
  command -v ip >/dev/null || { echo "missing required tool: ip" >&2; exit 3; }
  owner="${PKEXEC_UID:-${SUDO_UID:-}}"
  [[ "$owner" =~ ^[0-9]+$ && "$owner" -gt 0 ]] || { echo "cannot identify requesting desktop user" >&2; exit 2; }
  if ! ip link show dev "$tun" >/dev/null 2>&1; then
    ip tuntap add dev "$tun" mode tun user "$owner"
  fi
  exit 0
fi
[[ "$action" == up ]] || { echo "usage: $0 prepare|up|down TUN EXIT_IP EXIT_PORT" >&2; exit 2; }
trap 'down' ERR

for tool in ip nft resolvectl; do command -v "$tool" >/dev/null || { echo "missing required tool: $tool" >&2; exit 3; }; done
route="$(ip -4 route get "$exit_ip" | head -n1)"
physical_dev="$(awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' <<<"$route")"
physical_via="$(awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' <<<"$route")"
[[ -n "$physical_dev" && "$physical_dev" != "$tun" ]] || { echo "cannot determine physical exit route" >&2; exit 4; }
[[ "$physical_dev" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || { echo "invalid physical interface" >&2; exit 4; }
lan_cidr="$(ip -4 route show dev "$physical_dev" proto kernel scope link |
  awk '$1 ~ /^[0-9.]+\/[0-9]+$/ {print $1; exit}')"
[[ "$lan_cidr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] || {
  echo "cannot determine directly connected LAN" >&2
  exit 4
}
control_rules=""
for endpoint in "${endpoints[@]}"; do
  host="${endpoint%:*}"
  port="${endpoint##*:}"
  control_rules+="    oifname \"$physical_dev\" ip daddr $host udp dport $port accept"$'\n'
done
install -d -m 0700 /run/pqvpn
printf 'physical_dev=%q\nphysical_via=%q\nlan_cidr=%q\ncontrol_ips_csv=%q\n' \
  "$physical_dev" "$physical_via" "$lan_cidr" "$control_ips_csv" >"$state"
chmod 0600 "$state"

# Start from a known owned state. A crash intentionally leaves the firewall
# closed; the next authenticated start replaces it transactionally.
nft delete table inet pqvpn 2>/dev/null || true
ip link set "$tun" up mtu 1380
ip addr replace "$internal_ip/10" dev "$tun"
if [[ -n "$physical_via" ]]; then
  IFS=',' read -ra control_ips <<<"$control_ips_csv"
  for control_ip in "${control_ips[@]}"; do
    ip -4 route replace "$control_ip/32" via "$physical_via" dev "$physical_dev"
  done
else
  IFS=',' read -ra control_ips <<<"$control_ips_csv"
  for control_ip in "${control_ips[@]}"; do
    ip -4 route replace "$control_ip/32" dev "$physical_dev"
  done
fi

nft -f - <<EOF
table inet pqvpn {
  chain output {
    type filter hook output priority -200; policy drop;
    oifname "lo" accept
    oifname "$tun" accept
    oifname "$physical_dev" ip daddr $lan_cidr accept
$control_rules
    oifname "$physical_dev" udp sport 68 udp dport 67 accept
  }
}
EOF

# The host route above keeps the encrypted control/data socket outside the
# tunnel. Everything else moves through pqvpn0; IPv6 is explicitly unreachable
# until the exit's IPv6 data path is independently verified.
ip -4 route replace default dev "$tun" metric 5
ip -6 route replace unreachable default metric 5
case "$shield_profile" in
  dnscrypt)
    command -v ss >/dev/null || { echo "missing required tool: ss" >&2; exit 3; }
    ss -H -l -u -n | grep -Eq '127\.0\.2\.1:53([[:space:]]|$)' || {
      echo "DNSCrypt profile requires a UDP listener on 127.0.2.1:53" >&2; exit 5;
    }
    resolvectl dns "$tun" 127.0.2.1
    ;;
  off) resolvectl dns "$tun" 9.9.9.9 149.112.112.112 ;;
  *) resolvectl dns "$tun" 100.64.0.1 ;;
esac
resolvectl domain "$tun" '~.'
resolvectl default-route "$tun" yes

ip -4 route get 9.9.9.9 | grep -q "dev $tun"
nft list chain inet pqvpn output | grep -q 'policy drop'
trap - ERR
