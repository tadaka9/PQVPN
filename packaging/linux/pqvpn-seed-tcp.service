[Unit]
Description=PQVPN bootstrap TCP transport
After=network-online.target pqvpn-mainnet.service
Wants=network-online.target
Requires=pqvpn-mainnet.service

[Service]
Type=simple
User=pqvpn
Group=pqvpn
ExecStart=/usr/lib/pqvpn/pqvpn-tcp-relay server --listen-host * --listen-port 9090 --udp-host ::1 --udp-port 9090
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
MemoryMax=128M
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
